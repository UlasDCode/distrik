[node name="KZ7" parent="." instance=ExtResource("clue")]
position = Vector2(560, 900)
clue_id = "toxic_drums"
title = "Inside KZ-7"
description = "You pry the seal on KZ-7. Rows of black drums, hazard-striped, sweating something that stings your eyes through the rain. This isn't medical waste. You pocket a sample vial."
case_id = "case2"

[node name="DragMarks" parent="." instance=ExtResource("clue")]
position = Vector2(760, 900)
clue_id = "drag_marks"
title = "Drag Marks"
description = "The pier's scored with fresh drag marks that end at the black water. Something heavy went in here — and the tide didn't bring it back."
case_id = "case2"

[node name="PressBadge" parent="." instance=ExtResource("clue")]
position = Vector2(1050, 900)
clue_id = "press_badge"
title = "A Press Badge"
description = "A cracked press badge floating in an oil slick — 'K. Renner, Harbor Courier.' The dead man in the alley had a name, and a story he never got to file."
case_id = "case2"

[node name="RivalMark" parent="." instance=ExtResource("clue")]
position = Vector2(430, 900)
clue_id = "rival_mark"
title = "A Rival's Mark"
description = "Spray-stencilled on a container, half-scrubbed: the twin-serpent tag of the Zheng cartel. For a second it reads like they dumped this. Then you check the manifest again — Kanzaki Holdings, every crate. The Zheng didn't do this. They're just circling, watching a competitor sink something valuable in the harbor. Vultures always know where the dying is."
case_id = "case2"

[node name="Outfall" parent="." instance=ExtResource("clue")]
position = Vector2(1420, 900)
clue_id = "outfall_pipe"
title = "The Outfall Pipe"
description = "A storm drain the size of a doorway, venting black water straight into the harbor a hundred metres from where the district draws its supply. Not sabotage — engineering. Someone drew this on a plan, costed it, and signed off, because routing it further out would have cost more than the people it drains past are worth. The poison is new. The arithmetic that put the pipe here is forty years old."
case_id = "case2"

[node name="ExitToStreet" parent="." instance=ExtResource("exit")]
position = Vector2(150, 976)
