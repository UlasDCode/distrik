[node name="Directive" parent="." instance=ExtResource("clue")]
position = Vector2(620, 900)
clue_id = "reclamation_directive"
title = "Reclamation Order R-9"
description = "Buried three cabinets deep, misfiled on purpose. A city document — Municipal Reclamation Board letterhead, embossed and real. It rezones the harbor districts as a 'managed decline zone' and authorizes 'expedited industrial disposal, contractor of record: Kanzaki Holdings.' The poisoning wasn't a crime hidden from the city. It was a contract signed by it."
case_id = "case2"

[node name="BoardMinutes" parent="." instance=ExtResource("clue")]
position = Vector2(1240, 900)
clue_id = "board_minutes"
title = "Board Minutes, Redacted"
description = "Minutes from a Reclamation Board session. Every name blacked out but the vote itself: to proceed, seven to one. In the margin, a clerk's pencil note by the lone 'no' — 'reassigned, 3rd of the month.' Even the one conscience in the room got filed away."
case_id = "case2"

[node name="ExitToStreet" parent="." instance=ExtResource("exit")]
position = Vector2(140, 900)
